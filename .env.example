# NasMusicUI -- local machine config template
# Copy this to .env and fill in your values.
# start.sh sources .env automatically if present.
# All values are optional -- auto-discovery will fill in anything left blank.

# Path to your NasTech-Agent checkout (the repo that contains run_agent.py)
# NASMUSICUI_AGENT_DIR=/path/to/NasTech-Agent

# Python executable to use (defaults to the agent venv if found)
# NASMUSICUI_PYTHON=/path/to/python

# Bind address (default: 127.0.0.1 -- loopback only, safe default)
# NASMUSICUI_HOST=127.0.0.1

# Port to listen on (default: 8787)
# NASMUSICUI_PORT=8787

# Where to store sessions, workspaces, and other state (default: ~/.nastech/webui)
# NASMUSICUI_STATE_DIR=~/.nastech/webui

# Default workspace directory shown on first launch
# NASMUSICUI_DEFAULT_WORKSPACE=~/workspace

# Optional model override. Leave unset to use the active NasTech provider default.
# NASMUSICUI_DEFAULT_MODEL=

# Base directory for all NasTech state (affects all paths above if set)
# NASTECH_HOME=~/.nastech

# Path to your NasTech config.yaml (for toolsets and model config)
# NASTECH_CONFIG_PATH=~/.nastech/config.yaml

# Display name for the assistant in the UI (default: NasTech)
# NASMUSICUI_BOT_NAME=NasTech
